package NEGOCIO;

/**
 *
 * @author luisa
 */
public class Tiquete {
private Bus myBus;
private Asiento myAsiento;
private String estado;

    public Tiquete(Bus bus, Asiento asiento) {
        this.myBus = bus;
        this.myAsiento = asiento;
        this.estado = "PROGRAMADO";
    }

    public Bus getBus() {
        return myBus;
    }

    public Asiento getAsiento() {
        return myAsiento;
    }

    public void setBus(Bus bus) {
        this.myBus = bus;
    }

    public void setAsiento(Asiento asiento) {
        this.myAsiento = asiento;
    }

    public String getEstado() {
        return estado;
    }

    public void setEstado(String estado) {
        this.estado = estado;
    }

        
}
